# Which provider to use: "deepseek" (default) or "openrouter".
# Both expose an OpenAI-compatible API, so the same client code handles either.
PROVIDER=deepseek

# --- deepseek (used when PROVIDER=deepseek) ---
DEEPSEEK_API_KEY=

# --- openrouter (used when PROVIDER=openrouter) ---
OPENROUTER_API_KEY=
# Optional, shown on https://openrouter.ai/rankings for your app:
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# --- generic overrides (optional; otherwise sensible defaults per provider) ---
# BASE_URL=
# MODEL=
# e.g. for openrouter: MODEL=deepseek/deepseek-chat, MODEL=openai/gpt-4o, MODEL=anthropic/claude-3.5-sonnet

SAFE_MODE=true
MAX_RETRIES=3
MAX_TOOL_ITERATIONS=12
